# Cross-linked packages supported by install.sh --package
# Format: package-name path-from-skills.manifest
#
# Independent skills are intentionally absent: install either every skill or a
# complete cross-linked package. This avoids partial dependency installs.

project-management project-management/project-bootstrap
project-management project-management/status-ledger
project-management project-management/project-audit

interview interview
interview interview/reverse-brief

browser browser-session
browser browser-cleanup

coordination coordination/triage
coordination coordination/propose-tasks
coordination coordination/delegate
coordination coordination/harness
