# Cross-linked packages supported by install.sh --package
# Format: package-name path-from-skills.manifest
#
# Independent skills are intentionally absent: install either every skill or a
# complete cross-linked package. This avoids partial dependency installs.

project-management _collections/project-management/project-bootstrap
project-management _collections/project-management/status-ledger
project-management _collections/project-management/project-audit

browser _collections/browser/browser-session
browser _collections/browser/browser-cleanup

coordination _collections/coordination/triage
coordination _collections/coordination/propose-tasks
coordination _collections/coordination/delegate
coordination _collections/coordination/harness
coordination _collections/coordination/pause-for-review

design _collections/design/design-tool
design _collections/design/neon-neo-brutalist-minimal
